# OpenCord — variáveis de ambiente de desenvolvimento. Copie para `.env` e ajuste.
# Valores abaixo são APENAS para desenvolvimento local; nunca use em produção.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
# Origem pública da API (usada em URLs assinadas de anexos)
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
# Interface no navegador: links de convite viram <PUBLIC_APP_URL>/invite/<código> (vazio = só o código)
PUBLIC_APP_URL=http://localhost:5173
# Cabeçalho com o IP real do cliente posto pelo proxy de borda (ex.: cf-connecting-ip atrás da Cloudflare).
# Vazio = usa o IP da conexão. Só defina se TODO o tráfego passa por esse proxy (senão o cabeçalho é forjável).
CLIENT_IP_HEADER=

DATABASE_URL=postgresql://opencord:opencord_dev@127.0.0.1:5432/opencord_dev
REDIS_URL=redis://127.0.0.1:6379/10

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-0123456789abcdef
ATTACHMENT_URL_SECRET=dev-only-change-me-attachment-secret-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# LiveKit (modo --dev usa devkey/secret). URL vista pelos CLIENTES.
LIVEKIT_URL=ws://localhost:7880
# URL vista pela API (RoomService). Em dev no WSL com LiveKit no Windows, localhost funciona via encaminhamento.
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_TOKEN_TTL_SECONDS=600

# Armazenamento de anexos e imagens: "local" (disco) ou "s3" (Cloudflare R2, MinIO ou S3; ADR-0010)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
# Só com STORAGE_DRIVER=s3. R2: endpoint https://<account-id>.r2.cloudflarestorage.com, região auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=opencord-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
UPLOAD_MAX_BYTES=26214400

# Bootstrap do primeiro proprietário (usado por `pnpm --filter @opencord/db seed`)
SEED_OWNER_EMAIL=owner@opencord.local
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=dev-only-owner-password

# Entrada só com apelido (ADR-0007)
GUEST_JOIN_ENABLED=true
# Recomendado se a instância estiver exposta na internet; vazio = qualquer um que alcance o servidor entra.
INSTANCE_ACCESS_CODE=
INSTANCE_NAME=OpenCord
GUEST_JOIN_PER_IP_HOUR=10

# Download do app desktop para quem acessa pelo navegador (botão "Baixar o app": Windows, macOS e Linux).
# DOWNLOADS_DIR: pasta com os instaladores (.exe, .dmg, .AppImage, .deb); a API serve o mais recente de cada plataforma.
# DESKTOP_DOWNLOAD_URL: link externo só do instalador Windows (tem prioridade sobre o .exe da pasta).
DESKTOP_DOWNLOAD_URL=
DOWNLOADS_DIR=
# Requisições por minuto/IP nas rotas /auth/* (padrão 10; aumente só em dev/E2E)
AUTH_RATE_PER_MINUTE=10

# Ponte com o Slack (ADR-0033, docs/SLACK.md): app do Slack da instância. Vazio = aba Slack só mostra como configurar.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Moderação por IA (ADR-0036): com a chave, toda mensagem e anexo passam pelo Claude antes de publicar.
# Modelo padrão: claude-haiku-5-5 (o mais barato). Sem chave, o recurso fica desligado.
ANTHROPIC_API_KEY=
MODERATION_AI_MODEL=claude-haiku-5-5
MODERATION_AI_TIMEOUT_MS=12000
# true: se a IA estiver fora do ar, retém a mensagem para revisão em vez de liberar
MODERATION_AI_FAIL_CLOSED=false

# E-mail (ADR-0047): confirmar e-mail, verificação em duas etapas por e-mail e aviso de acesso novo.
# Resend (recomendado): chave da API e remetente de um domínio validado no Resend. Tem prioridade sobre o SMTP.
RESEND_API_KEY=
RESEND_FROM=OpenCord <naoresponda@opencord.pro>
# Ou SMTP do provedor do domínio. Sem Resend nem SMTP_HOST, nada de e-mail.
SMTP_HOST=
SMTP_PORT=587
# true para TLS direto na porta 465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OpenCord <naoresponda@opencord.pro>

# Seletor de GIFs (ADR-0044): chave de app do KLIPY (partner.klipy.com → API Keys). Vai ao app de cada pessoa
# (os termos do KLIPY exigem que as buscas saiam do cliente); sem ela o botão GIF fica escondido.
KLIPY_APP_KEY=

# Spotify na música da chamada (ADR-0041): app em developer.spotify.com (só metadados, client credentials).
# A pesquisa só aparece com as duas chaves e com YOUTUBE_API_KEY.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Expurgo automático (ADR-0039), em dias: sessões encerradas/expiradas (IP, aparelho), auditoria, casos de moderação
# já decididos e bloqueios de dispositivo. Mudou, mude a Política de privacidade (app e landing).
RETENTION_SESSIONS_DAYS=180
RETENTION_AUDIT_DAYS=365
RETENTION_MODERATION_DAYS=365
RETENTION_DEVICE_BANS_DAYS=365

# Bots oficiais (ADR-0037): segredo compartilhado entre a API e o container dos bots (gere com o mesmo comando acima).
# Com ele, o container pede os próprios tokens na subida; vazio = rota desligada.
OFFICIAL_BOTS_SECRET=
