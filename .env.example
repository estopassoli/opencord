# OpenCord — variáveis de ambiente de desenvolvimento. Copie para `.env` e ajuste.
# Valores abaixo são APENAS para desenvolvimento local; nunca use em produção.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
# Origem pública da API (usada em URLs assinadas de anexos)
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://opencord:opencord_dev@127.0.0.1:5432/opencord_dev
REDIS_URL=redis://127.0.0.1:6379/10

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-0123456789abcdef
ATTACHMENT_URL_SECRET=dev-only-change-me-attachment-secret-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# LiveKit (modo --dev usa devkey/secret). URL vista pelos CLIENTES.
LIVEKIT_URL=ws://localhost:7880
# URL vista pela API (RoomService). Em dev no WSL com LiveKit no Windows, localhost funciona via encaminhamento.
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_TOKEN_TTL_SECONDS=600

# Armazenamento de anexos: "local" (disco) ou "s3" (MinIO/S3 compatível)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
UPLOAD_MAX_BYTES=26214400

# Bootstrap do primeiro proprietário (usado por `pnpm --filter @opencord/db seed`)
SEED_OWNER_EMAIL=owner@opencord.local
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=dev-only-owner-password

# Entrada só com apelido (ADR-0007)
GUEST_JOIN_ENABLED=true
# Recomendado se a instância estiver exposta na internet; vazio = qualquer um que alcance o servidor entra.
INSTANCE_ACCESS_CODE=
INSTANCE_NAME=OpenCord
GUEST_JOIN_PER_IP_HOUR=10

# Download do app desktop para quem acessa pelo navegador (botão "Baixar para Windows").
# Use UM dos dois: link externo do instalador OU pasta com os .exe (a API serve o mais recente).
DESKTOP_DOWNLOAD_URL=
DOWNLOADS_DIR=
# Requisições por minuto/IP nas rotas /auth/* (padrão 10; aumente só em dev/E2E)
AUTH_RATE_PER_MINUTE=10
