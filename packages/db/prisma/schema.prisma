// OpenCord — modelo persistente. Ver docs/DATABASE.md.
// IDs UUIDv7 (ordenáveis por tempo); paginação de mensagens por cursor composto (createdAt, id).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  /**
   * null para usuários que entram só com apelido (ADR-0007).
   */
  email              String?   @unique
  username           String    @unique
  /// última troca do @ (uma vez a cada 30 dias); null = nunca trocou
  usernameChangedAt  DateTime? @db.Timestamptz(3)
  /**
   * null para usuários só com apelido: não há login por senha.
   */
  passwordHash       String?
  displayName        String
  /**
   * Apelido normalizado (minúsculas, sem acento) — único entre todos os usuários.
   */
  nickKey            String?   @unique
  avatarKey          String?
  /// Super admin da instância: vê todos os servidores e, ao entrar (auditado), tem permissões de dono (ADR-0013).
  isInstanceAdmin    Boolean   @default(false)
  /// identidade de um webhook de entrada (ADR-0030): autor das mensagens que chegam por ele, sem login
  isWebhook          Boolean   @default(false)
  /// usuário de um bot (ADR-0032): autentica por token `ocb_…`, é membro como qualquer pessoa, selo APP
  isBot              Boolean   @default(false)
  /// selo de verificado no perfil, dado pelo super admin (adendo da ADR-0013)
  verified           Boolean   @default(false)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  disabledAt         DateTime? @db.Timestamptz(3)
  /// verificação em duas etapas (ADR-0046): segredo TOTP cifrado (AES-GCM, chave derivada do JWT_ACCESS_SECRET)
  totpSecret         String?
  totpEnabledAt      DateTime? @db.Timestamptz(3)
  /// SHA-256 dos códigos de recuperação ainda não usados
  totpRecoveryHashes String[]  @default([])
  /// último passo de 30 s aceito: o mesmo código não entra duas vezes
  totpLastStep       BigInt?
  /// e-mail confirmado por código (ADR-0047); trocar o e-mail zera
  emailVerifiedAt    DateTime? @db.Timestamptz(3)
  /// verificação em duas etapas por código no e-mail ligada (alternativa ao app; ADR-0047)
  twoFactorEmailAt   DateTime? @db.Timestamptz(3)
  /// perfil (ADR-0048): "sobre mim" com a formatação do chat
  bio                String    @default("")
  /// banner enviado (banners/<bannerKey>) ou GIF do KLIPY (URL como veio); no máximo um dos dois
  bannerKey          String?
  bannerUrl          String?
  /// foto por GIF do KLIPY (no lugar de avatarKey)
  avatarUrl          String?
  /// duas cores #rrggbb que tingem o cartão de perfil; vazio = padrão
  profileColors      String[]  @default([])
  /// últimas fotos usadas ("key:<nome>" ou "url:<https>"), mais recente primeiro, até 6
  recentAvatars      String[]  @default([])
  /// quando aceitou os Termos de uso e a Política de privacidade (ADR-0039); null = ainda precisa aceitar no app
  termsAcceptedAt    DateTime? @db.Timestamptz(3)
  /// conta excluída pela própria pessoa (ADR-0039): linha anonimizada (as mensagens ficam como "Usuário removido")
  deletedAt          DateTime? @db.Timestamptz(3)

  sessions        Session[]
  ownedServers    Server[]             @relation("ServerOwner")
  invites         Invite[]
  sounds          SoundEffect[]
  recordings      CallRecording[]
  events          ServerEvent[]
  eventRsvps      EventRsvp[]
  webhooksCreated Webhook[]            @relation("WebhookCreator")
  webhookOf       Webhook?             @relation("WebhookUser")
  botsOwned       Bot[]                @relation("BotOwner")
  botOf           Bot?                 @relation("BotUser")
  boardCards      BoardCard[]
  badges          UserBadge[]
  pollVotes       PollVote[]
  memberships     ServerMember[]
  bans            ServerBan[]          @relation("BannedUser")
  moderationCases ModerationCase[]     @relation("ModerationCaseAuthor")
  messages        Message[]
  reactions       Reaction[]
  readStates      ReadState[]
  settings        UserSettings?
  friendshipsOut  Friendship[]         @relation("FriendRequester")
  friendshipsIn   Friendship[]         @relation("FriendAddressee")
  blocksMade      Block[]              @relation("Blocker")
  blocksReceived  Block[]              @relation("Blocked")
  conversations   ConversationMember[]
  auditLogs       AuditLog[]
  attachments     Attachment[]
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  /**
   * SHA-256 do refresh token; o token em claro nunca é persistido.
   */
  refreshTokenHash String    @unique
  /**
   * Família de rotação: reuso de token já rotacionado revoga a família inteira.
   */
  familyId         String    @db.Uuid
  deviceId         String?
  userAgent        String?
  /// impressão digital do aparelho (app desktop: hash dos MACs) e IP de origem: base do bloqueio de dispositivo (ADR-0036)
  hardwareId       String?
  ip               String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  rotatedAt        DateTime? @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

enum FriendshipStatus {
  pending
  accepted
}

model Friendship {
  id          String           @id @default(uuid(7)) @db.Uuid
  requesterId String           @db.Uuid
  addresseeId String           @db.Uuid
  /**
   * Par canônico (menor id, maior id) para unicidade independente da direção.
   */
  userLowId   String           @db.Uuid
  userHighId  String           @db.Uuid
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  acceptedAt  DateTime?        @db.Timestamptz(3)
  requester   User             @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([addresseeId])
}

model Block {
  id        String   @id @default(uuid(7)) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Server {
  id              String           @id @default(uuid(7)) @db.Uuid
  name            String
  ownerId         String           @db.Uuid
  iconKey         String?
  /// Servidor oficial da instância: aberto a todos (entrada automática, diretório) e com selo de verificado.
  /// Os demais são privados: só entra quem tem convite.
  official        Boolean          @default(false)
  /// tema do servidor: cor de destaque (#rrggbb) e papel de parede da conversa (nome em wallpapers/)
  accent          String?
  wallpaperKey    String?
  /// Só o selo de verificado (marcado pelo super admin); não muda privacidade, diretório nem entrada (ADR-0013).
  verified        Boolean          @default(false)
  /// regras do servidor que a moderação por IA leva em conta (ADR-0036); null = só as regras gerais
  aiRules         String?
  /// canal de ausentes (ADR-0049): canal de voz para onde vai quem fica parado afkTimeoutSec segundos em voz
  afkChannelId    String?          @db.Uuid
  afkTimeoutSec   Int              @default(300)
  /// perfil do servidor (ADR-0050): descrição, até 5 características ({emoji, label}), faixa (cor pronta ou imagem)
  description     String           @default("")
  traits          Json             @default("[]")
  bannerColor     String?
  bannerKey       String?
  /// imagem de fundo da tela de convite
  inviteBgKey     String?
  /// engajamento: canal das mensagens do sistema (boas-vindas) e notificação padrão ("all" | "mentions")
  systemChannelId String?          @db.Uuid
  welcomeEnabled  Boolean          @default(false)
  defaultNotify   String           @default("mentions")
  /// convites pausados: nenhum convite deixa entrar
  invitesPaused   Boolean          @default(false)
  emojis          ServerEmoji[]
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  owner           User             @relation("ServerOwner", fields: [ownerId], references: [id])
  invites         Invite[]
  sounds          SoundEffect[]
  recordings      CallRecording[]
  events          ServerEvent[]
  webhooks        Webhook[]
  slackLinks      SlackLink[]
  bans            ServerBan[]
  moderationCases ModerationCase[]
  members         ServerMember[]
  roles           Role[]
  categories      Category[]
  channels        Channel[]
  auditLogs       AuditLog[]
}

model ServerMember {
  serverId     String       @db.Uuid
  userId       String       @db.Uuid
  nickname     String?
  joinedAt     DateTime     @default(now()) @db.Timestamptz(3)
  /// castigo (ADR-0034): até quando não escreve, reage nem entra em voz
  timeoutUntil DateTime?    @db.Timestamptz(3)
  /// super admin invisível (adendo ADR-0013): não aparece em listas, contagens nem presença; só ele se vê
  hidden       Boolean      @default(false)
  /// convite usado para entrar (ADR-0050); null = entrada direta, oficial ou antes disto
  inviteCode   String?
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        MemberRole[]

  @@id([serverId, userId])
  @@index([userId])
}

/// Banimento (ADR-0034): quem está aqui não entra no servidor (convite, diretório, bot) até ser desbanido.
/// Moderação por IA (ADR-0036): envio retido antes de publicar. `verdict` block (IA segura) ou review (em dúvida);
/// `status` pending (fila dos moderadores) | approved (publicado, `publishedMessageId`) | rejected | blocked (IA).
model ModerationCase {
  id                 String       @id @default(uuid(7)) @db.Uuid
  serverId           String?      @db.Uuid
  channelId          String?      @db.Uuid
  conversationId     String?      @db.Uuid
  authorId           String       @db.Uuid
  requestId          String       @db.Uuid
  body               String
  replyToId          String?      @db.Uuid
  verdict            String
  category           String?
  reason             String
  status             String       @default("pending")
  reviewedById       String?      @db.Uuid
  reviewedAt         DateTime?    @db.Timestamptz(3)
  reviewNote         String?
  publishedMessageId String?      @db.Uuid
  /// ação automática aplicada ao autor: 'suspended' | 'suspended+device'
  autoAction         String?
  model              String?
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  server             Server?      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  author             User         @relation("ModerationCaseAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  attachments        Attachment[]

  @@index([serverId, status, createdAt])
  @@index([authorId, createdAt])
}

/// Bloqueio de dispositivo (ADR-0036): quem tentar entrar (apelido, conta, login, refresh) com este aparelho/IP é recusado.
model DeviceBan {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// 'hardware' (hash dos MACs do app desktop) | 'device' (identificador do app no aparelho) | 'ip'
  kind        String
  value       String
  /// pessoa que originou o bloqueio (null se a conta sumiu)
  userId      String?  @db.Uuid
  reason      String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([kind, value])
  @@index([userId])
}

model ServerBan {
  serverId    String   @db.Uuid
  userId      String   @db.Uuid
  reason      String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user        User     @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([serverId, userId])
  @@index([userId])
}

model Role {
  id            String         @id @default(uuid(7)) @db.Uuid
  serverId      String         @db.Uuid
  name          String
  /**
   * 0 = @everyone; maior = mais alto na hierarquia.
   */
  position      Int
  permissions   Int
  color         String?
  isEveryone    Boolean        @default(false)
  server        Server         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  members       MemberRole[]
  reactionRoles ReactionRole[]

  @@index([serverId])
}

model MemberRole {
  serverId String       @db.Uuid
  userId   String       @db.Uuid
  roleId   String       @db.Uuid
  member   ServerMember @relation(fields: [serverId, userId], references: [serverId, userId], onDelete: Cascade)
  role     Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([serverId, userId, roleId])
  @@index([roleId])
}

model Category {
  id       String    @id @default(uuid(7)) @db.Uuid
  serverId String    @db.Uuid
  name     String
  position Int
  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channels Channel[]

  @@index([serverId])
}

enum ChannelKind {
  text
  voice
  /// quadro kanban (ADR-0017): colunas de cards, sem mensagens
  board
  /// fórum (ADR-0052): cada mensagem raiz é um post com título; as respostas apontam para ele
  forum
}

model Channel {
  id          String                      @id @default(uuid(7)) @db.Uuid
  serverId    String                      @db.Uuid
  categoryId  String?                     @db.Uuid
  kind        ChannelKind
  name        String
  topic       String?
  position    Int
  createdAt   DateTime                    @default(now()) @db.Timestamptz(3)
  /// canal de voz "criador de salas": entrar nele cria uma sala temporária e põe a pessoa lá (ADR-0029)
  roomHub     Boolean                     @default(false)
  /// sala temporária criada por um criador de salas: some quando esvazia
  temporary   Boolean                     @default(false)
  /// dona da sala temporária (ADR-0040): tranca, convida, limita vagas e remove gente; passa adiante quando sai
  ownerId     String?                     @db.Uuid
  /// limite de vagas da sala temporária (null = o máximo do canal)
  userLimit   Int?
  /// modo lento (ADR-0052): segundos entre duas mensagens da mesma pessoa (0 = desligado)
  slowmodeSec Int                         @default(0)
  server      Server                      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  category    Category?                   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  overrides   ChannelPermissionOverride[]
  messages    Message[]
  readStates  ReadState[]
  /// canal de texto: cada mensagem nova vira card neste quadro (ADR-0017)
  boardId     String?                     @db.Uuid
  board       Channel?                    @relation("BoardFeed", fields: [boardId], references: [id], onDelete: SetNull)
  feeds       Channel[]                   @relation("BoardFeed")
  cards       BoardCard[]                 @relation("BoardCards")
  sourced     BoardCard[]                 @relation("BoardCardSource")
  recordings  CallRecording[]
  events      ServerEvent[]
  webhooks    Webhook[]
  slackLinks  SlackLink[]

  @@index([serverId])
}

enum BoardColumn {
  new
  triage
  doing
  done
}

/// Card de um quadro kanban (ADR-0017). Nasce de uma mensagem do canal que alimenta o quadro ou é criado à mão.
model BoardCard {
  id              String      @id @default(uuid(7)) @db.Uuid
  boardId         String      @db.Uuid
  column          BoardColumn @default(new)
  /// ordem dentro da coluna (menor = mais acima)
  position        Float
  title           String
  body            String      @default("")
  reporterId      String?     @db.Uuid
  /// mensagem de origem
  messageId       String?     @unique @db.Uuid
  sourceChannelId String?     @db.Uuid
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  board           Channel     @relation("BoardCards", fields: [boardId], references: [id], onDelete: Cascade)
  source          Channel?    @relation("BoardCardSource", fields: [sourceChannelId], references: [id], onDelete: SetNull)
  reporter        User?       @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  message         Message?    @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([boardId, column, position])
}

/// Enquete presa a uma mensagem (ADR-0018). Encerra em endsAt (null = sem prazo) ou quando o autor encerra.
model Poll {
  id        String       @id @default(uuid(7)) @db.Uuid
  messageId String       @unique @db.Uuid
  question  String
  /// várias opções por pessoa
  multiple  Boolean      @default(false)
  endsAt    DateTime?    @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id       String     @id @default(uuid(7)) @db.Uuid
  pollId   String     @db.Uuid
  text     String
  position Int
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes    PollVote[]

  @@index([pollId])
}

model PollVote {
  pollId    String     @db.Uuid
  optionId  String     @db.Uuid
  userId    String     @db.Uuid
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, optionId, userId])
  @@index([pollId, userId])
}

/// Cargo por reação (ADR-0019): reagir com o emoji nesta mensagem dá o cargo; tirar a reação tira o cargo.
model ReactionRole {
  messageId String   @db.Uuid
  emoji     String
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([messageId, emoji])
  @@index([roleId])
}

enum OverrideSubject {
  role
  member
}

model ChannelPermissionOverride {
  channelId   String          @db.Uuid
  subjectType OverrideSubject
  subjectId   String          @db.Uuid
  allow       Int             @default(0)
  deny        Int             @default(0)
  channel     Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([channelId, subjectType, subjectId])
}

enum ConversationKind {
  dm
  group
}

model Conversation {
  id         String               @id @default(uuid(7)) @db.Uuid
  kind       ConversationKind
  name       String?
  /**
   * Para DMs: par canônico "lowId:highId", garante uma DM por par.
   */
  dmKey      String?              @unique
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  members    ConversationMember[]
  messages   Message[]
  readStates ReadState[]
}

model ConversationMember {
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  joinedAt       DateTime     @default(now()) @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id                 String         @id @default(uuid(7)) @db.Uuid
  authorId           String         @db.Uuid
  /**
   * XOR com conversationId (constraint CHECK na migração).
   */
  channelId          String?        @db.Uuid
  conversationId     String?        @db.Uuid
  /**
   * Idempotência: o mesmo requestId do mesmo autor não cria segunda mensagem.
   */
  requestId          String         @db.Uuid
  body               String
  mentions           String[]       @db.Uuid
  mentionEveryone    Boolean        @default(false)
  replyToId          String?        @db.Uuid
  /// responder no privado (ADR-0042): mensagem de DM que cita uma mensagem de canal
  privateReplyToId   String?        @db.Uuid
  /// título do post (ADR-0052): só em mensagem raiz de canal de fórum
  title              String?
  /// encaminhada (ADR-0053): de qual mensagem e canal veio; sem FK de propósito (a original pode sumir)
  forwardedFromId    String?        @db.Uuid
  forwardedChannelId String?        @db.Uuid
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  editedAt           DateTime?      @db.Timestamptz(3)
  deletedAt          DateTime?      @db.Timestamptz(3)
  /**
   * Fixada no canal/conversa (quem fixou fica em pinnedById, sem relação).
   */
  pinnedAt           DateTime?      @db.Timestamptz(3)
  pinnedById         String?        @db.Uuid
  /// cartões ricos (ADR-0034): array de Embed do contrato; só bots/webhooks
  embeds             Json           @default("[]")
  /// botões e menus (ADR-0034): array de ActionRow do contrato; só bots
  components         Json           @default("[]")
  author             User           @relation(fields: [authorId], references: [id])
  channel            Channel?       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation       Conversation?  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo            Message?       @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies            Message[]      @relation("Replies")
  privateReplyTo     Message?       @relation("PrivateReplies", fields: [privateReplyToId], references: [id], onDelete: SetNull)
  privateReplies     Message[]      @relation("PrivateReplies")
  attachments        Attachment[]
  reactions          Reaction[]
  boardCard          BoardCard?
  poll               Poll?
  reactionRoles      ReactionRole[]

  @@unique([authorId, requestId])
  @@index([channelId, createdAt, id])
  @@index([conversationId, createdAt, id])
}

model Attachment {
  id           String          @id @default(uuid(7)) @db.Uuid
  uploaderId   String          @db.Uuid
  /**
   * null até ser vinculado a uma mensagem; órfãos expiram (limpeza periódica).
   */
  messageId    String?         @db.Uuid
  storageKey   String          @unique
  mime         String
  sizeBytes    Int
  originalName String
  sha256       String
  width        Int?
  height       Int?
  /**
   * retido pela moderação por IA (ADR-0036): não expira como órfão enquanto o caso existe
   */
  caseId       String?         @db.Uuid
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  uploader     User            @relation(fields: [uploaderId], references: [id])
  message      Message?        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  case         ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([caseId])
  @@index([uploaderId, createdAt])
}

model Reaction {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
}

model ReadState {
  id                String        @id @default(uuid(7)) @db.Uuid
  userId            String        @db.Uuid
  channelId         String?       @db.Uuid
  conversationId    String?       @db.Uuid
  lastReadMessageId String?       @db.Uuid
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel           Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation      Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@unique([userId, conversationId])
  @@index([userId, updatedAt])
}

model UserSettings {
  userId    String   @id @db.Uuid
  version   Int
  json      Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String   @db.Uuid
  serverId  String?  @db.Uuid
  action    String
  targetId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  actor     User     @relation(fields: [actorId], references: [id])
  server    Server?  @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
  @@index([createdAt])
}

/// Configuração da instância editada no painel do super admin (ADR-0020). Uma linha só (id = 1).
model InstanceConfig {
  id                Int      @id @default(1)
  /// false: ninguém novo entra (nem conta, nem só apelido); quem já tem conta continua entrando.
  registrationOpen  Boolean  @default(true)
  /// Aviso em faixa no topo do app para todo mundo (null = sem aviso).
  announcementText  String?
  /// info | warning | success
  announcementTone  String   @default("info")
  /// Limite de upload menor que o do ambiente (UPLOAD_MAX_BYTES); null = o do ambiente.
  uploadMaxBytes    Int?
  /// Moderação por IA (ADR-0036): ligada na instância (precisa de ANTHROPIC_API_KEY) e se vale em mensagens diretas.
  aiModeration      Boolean  @default(true)
  aiModerationDms   Boolean  @default(false)
  /// bloqueio automático em conteúdo grave (pornografia, menores, violência gráfica) com confiança alta: suspende a conta
  aiAutoBlock       Boolean  @default(false)
  /// ... e bloqueia também o dispositivo (hardwareId, deviceId e IP das sessões da pessoa)
  aiAutoBlockDevice Boolean  @default(false)
  /// canal de contato para pedidos sobre dados pessoais (LGPD, ADR-0039); aparece na política dentro do app
  privacyContact    String?
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById       String?  @db.Uuid
}

/// Convite para servidor privado: código aleatório, sem expiração; o criador ou quem gerencia o servidor revoga.
model Invite {
  code      String    @id
  serverId  String    @db.Uuid
  creatorId String    @db.Uuid
  uses      Int       @default(0)
  /// validade e limite de usos (ADR-0050); null = sem
  expiresAt DateTime? @db.Timestamptz(3)
  maxUses   Int?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([serverId])
}

/// Efeito sonoro do servidor (ADR-0016): qualquer membro envia; quem está na chamada toca para todos dela.
model SoundEffect {
  id          String   @id @default(uuid(7)) @db.Uuid
  serverId    String   @db.Uuid
  name        String
  /// emoji opcional mostrado no botão
  emoji       String?
  /// volume do som (0–1), escolhido no envio
  volume      Float    @default(1)
  storageKey  String
  mime        String
  sizeBytes   Int
  durationMs  Int
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([serverId])
}

/// Gravação de uma chamada de voz (ADR-0023): montada no app de quem grava e enviada em partes durante a gravação.
/// Pronta, fica disponível para download por 24 h e depois é apagada (arquivo e linha).
model CallRecording {
  id          String    @id @default(uuid(7)) @db.Uuid
  serverId    String    @db.Uuid
  channelId   String    @db.Uuid
  createdById String    @db.Uuid
  /// recording | ready
  status      String    @default("recording")
  storageKey  String
  /// envio em partes do armazenamento (S3 multipart); null no disco local
  uploadId    String?
  /// etiquetas das partes já enviadas, na ordem ([{ n, etag }])
  parts       Json      @default("[]")
  sizeBytes   BigInt    @default(0)
  durationMs  Int       @default(0)
  startedAt   DateTime  @default(now()) @db.Timestamptz(3)
  endedAt     DateTime? @db.Timestamptz(3)
  /// quando o arquivo some (pronta: fim + 24 h)
  expiresAt   DateTime  @db.Timestamptz(3)
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([channelId, status])
  @@index([expiresAt])
}

/// Evento combinado no servidor ("sexta 21h, raid"), com confirmação de presença (ADR-0028).
model ServerEvent {
  id          String      @id @default(uuid(7)) @db.Uuid
  serverId    String      @db.Uuid
  /// canal de voz onde vai acontecer (opcional)
  channelId   String?     @db.Uuid
  createdById String      @db.Uuid
  title       String
  description String      @default("")
  startsAt    DateTime    @db.Timestamptz(3)
  endsAt      DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  server      Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channel     Channel?    @relation(fields: [channelId], references: [id], onDelete: SetNull)
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  rsvps       EventRsvp[]

  @@index([serverId, startsAt])
}

model EventRsvp {
  eventId   String      @db.Uuid
  userId    String      @db.Uuid
  /// going | maybe
  status    String
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  event     ServerEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

/// Webhook de entrada (ADR-0030): um link secreto que recebe POST e vira mensagem num canal, assinada por um usuário
/// próprio do webhook (isWebhook).
model Webhook {
  id          String   @id @default(uuid(7)) @db.Uuid
  serverId    String   @db.Uuid
  channelId   String   @db.Uuid
  /// segredo do link (hex de 32 bytes)
  token       String   @unique
  name        String
  userId      String   @unique @db.Uuid
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user        User     @relation("WebhookUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("WebhookCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([serverId])
}

/// Bot (ADR-0032): aplicativo feito por quem desenvolve. Tem um usuário próprio (isBot), um token longo (só o hash
/// fica aqui) e uma lista de comandos de barra. Entra em servidores como membro (quem gerencia adiciona).
model Bot {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @unique @db.Uuid
  ownerId     String    @db.Uuid
  description String    @default("")
  /// aparece em "Adicionar bot" de qualquer servidor; privado = só pelo id
  public      Boolean   @default(false)
  /// SHA-256 do token `ocb_…`; o token em claro nunca é persistido
  tokenHash   String    @unique
  /// comandos de barra (BotCommand[] do contrato)
  commands    Json      @default("[]")
  /// bot oficial da instância (ADR-0037): chave fixa (YOU6, DINAMO…) pela qual o container dos bots o reconhece
  officialKey String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime? @db.Timestamptz(3)
  user        User      @relation("BotUser", fields: [userId], references: [id], onDelete: Cascade)
  owner       User      @relation("BotOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, officialKey])
  @@index([ownerId])
}

/// Ponte com o Slack (ADR-0033): um canal de texto do OpenCord espelhado num canal do Slack (e vice-versa).
/// O app do Slack é um por instância (variáveis SLACK_BOT_TOKEN/SLACK_SIGNING_SECRET); aqui só o mapeamento.
model SlackLink {
  id               String   @id @default(uuid(7)) @db.Uuid
  serverId         String   @db.Uuid
  channelId        String   @unique @db.Uuid
  slackChannelId   String   @unique
  slackChannelName String
  createdById      String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  server           Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channel          Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([serverId])
}

/// Insígnia (ADR-0043): criada pelo super admin; ícone da biblioteca + cor, ou imagem enviada (badges/<imageKey>).
model Badge {
  id          String      @id @default(uuid(7)) @db.Uuid
  name        String
  description String      @default("")
  icon        String?
  color       String?
  imageKey    String?
  position    Int         @default(0)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  holders     UserBadge[]
}

model UserBadge {
  userId      String   @db.Uuid
  badgeId     String   @db.Uuid
  grantedById String?  @db.Uuid
  /// escolhida pela pessoa para aparecer ao lado do nome (até 3)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge       Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@index([badgeId])
}

/// Emoji personalizado do servidor (ADR-0050): imagem em emojis/<imageKey>; usado como <:nome:id> no chat
model ServerEmoji {
  id          String   @id @default(uuid(7)) @db.Uuid
  serverId    String   @db.Uuid
  name        String
  imageKey    String
  animated    Boolean  @default(false)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name])
}
