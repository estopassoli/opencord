// OpenCord — modelo persistente. Ver docs/DATABASE.md.
// IDs UUIDv7 (ordenáveis por tempo); paginação de mensagens por cursor composto (createdAt, id).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /** null para usuários que entram só com apelido (ADR-0007). */
  email        String?   @unique
  username     String    @unique
  /** null para usuários só com apelido: não há login por senha. */
  passwordHash String?
  displayName  String
  /** Apelido normalizado (minúsculas, sem acento) — único entre todos os usuários. */
  nickKey      String?   @unique
  avatarKey    String?
  /// Super admin da instância: vê todos os servidores e, ao entrar (auditado), tem permissões de dono (ADR-0013).
  isInstanceAdmin Boolean @default(false)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  disabledAt   DateTime? @db.Timestamptz(3)

  sessions          Session[]
  ownedServers      Server[]             @relation("ServerOwner")
  invites           Invite[]
  sounds            SoundEffect[]
  boardCards        BoardCard[]
  pollVotes         PollVote[]
  memberships       ServerMember[]
  messages          Message[]
  reactions         Reaction[]
  readStates        ReadState[]
  settings          UserSettings?
  friendshipsOut    Friendship[]         @relation("FriendRequester")
  friendshipsIn     Friendship[]         @relation("FriendAddressee")
  blocksMade        Block[]              @relation("Blocker")
  blocksReceived    Block[]              @relation("Blocked")
  conversations     ConversationMember[]
  auditLogs         AuditLog[]
  attachments       Attachment[]
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  /** SHA-256 do refresh token; o token em claro nunca é persistido. */
  refreshTokenHash String    @unique
  /** Família de rotação: reuso de token já rotacionado revoga a família inteira. */
  familyId         String    @db.Uuid
  deviceId         String?
  userAgent        String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  rotatedAt        DateTime? @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

enum FriendshipStatus {
  pending
  accepted
}

model Friendship {
  id          String           @id @default(uuid(7)) @db.Uuid
  requesterId String           @db.Uuid
  addresseeId String           @db.Uuid
  /** Par canônico (menor id, maior id) para unicidade independente da direção. */
  userLowId   String           @db.Uuid
  userHighId  String           @db.Uuid
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  acceptedAt  DateTime?        @db.Timestamptz(3)
  requester   User             @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([addresseeId])
}

model Block {
  id        String   @id @default(uuid(7)) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Server {
  id         String         @id @default(uuid(7)) @db.Uuid
  name       String
  ownerId    String         @db.Uuid
  iconKey    String?
  /// Servidor oficial da instância: aberto a todos (entrada automática, diretório) e com selo de verificado.
  /// Os demais são privados: só entra quem tem convite.
  official   Boolean        @default(false)
  /// Só o selo de verificado (marcado pelo super admin); não muda privacidade, diretório nem entrada (ADR-0013).
  verified   Boolean        @default(false)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  owner      User           @relation("ServerOwner", fields: [ownerId], references: [id])
  invites    Invite[]
  sounds     SoundEffect[]
  members    ServerMember[]
  roles      Role[]
  categories Category[]
  channels   Channel[]
  auditLogs  AuditLog[]
}

model ServerMember {
  serverId String       @db.Uuid
  userId   String       @db.Uuid
  nickname String?
  joinedAt DateTime     @default(now()) @db.Timestamptz(3)
  server   Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles    MemberRole[]

  @@id([serverId, userId])
  @@index([userId])
}

model Role {
  id              String       @id @default(uuid(7)) @db.Uuid
  serverId        String       @db.Uuid
  name            String
  /** 0 = @everyone; maior = mais alto na hierarquia. */
  position        Int
  permissions     Int
  color           String?
  isEveryone      Boolean      @default(false)
  server          Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  members         MemberRole[]

  @@index([serverId])
}

model MemberRole {
  serverId String       @db.Uuid
  userId   String       @db.Uuid
  roleId   String       @db.Uuid
  member   ServerMember @relation(fields: [serverId, userId], references: [serverId, userId], onDelete: Cascade)
  role     Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([serverId, userId, roleId])
  @@index([roleId])
}

model Category {
  id       String    @id @default(uuid(7)) @db.Uuid
  serverId String    @db.Uuid
  name     String
  position Int
  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channels Channel[]

  @@index([serverId])
}

enum ChannelKind {
  text
  voice
  /// quadro kanban (ADR-0017): colunas de cards, sem mensagens
  board
}

model Channel {
  id         String                      @id @default(uuid(7)) @db.Uuid
  serverId   String                      @db.Uuid
  categoryId String?                     @db.Uuid
  kind       ChannelKind
  name       String
  topic      String?
  position   Int
  createdAt  DateTime                    @default(now()) @db.Timestamptz(3)
  server     Server                      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  category   Category?                   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  overrides  ChannelPermissionOverride[]
  messages   Message[]
  readStates ReadState[]
  /// canal de texto: cada mensagem nova vira card neste quadro (ADR-0017)
  boardId    String?                     @db.Uuid
  board      Channel?                    @relation("BoardFeed", fields: [boardId], references: [id], onDelete: SetNull)
  feeds      Channel[]                   @relation("BoardFeed")
  cards      BoardCard[]                 @relation("BoardCards")
  sourced    BoardCard[]                 @relation("BoardCardSource")

  @@index([serverId])
}

enum BoardColumn {
  new
  triage
  doing
  done
}

/// Card de um quadro kanban (ADR-0017). Nasce de uma mensagem do canal que alimenta o quadro ou é criado à mão.
model BoardCard {
  id              String      @id @default(uuid(7)) @db.Uuid
  boardId         String      @db.Uuid
  column          BoardColumn @default(new)
  /// ordem dentro da coluna (menor = mais acima)
  position        Float
  title           String
  body            String      @default("")
  reporterId      String?     @db.Uuid
  /// mensagem de origem
  messageId       String?     @unique @db.Uuid
  sourceChannelId String?     @db.Uuid
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  board           Channel     @relation("BoardCards", fields: [boardId], references: [id], onDelete: Cascade)
  source          Channel?    @relation("BoardCardSource", fields: [sourceChannelId], references: [id], onDelete: SetNull)
  reporter        User?       @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  message         Message?    @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([boardId, column, position])
}

/// Enquete presa a uma mensagem (ADR-0018). Encerra em endsAt (null = sem prazo) ou quando o autor encerra.
model Poll {
  id        String       @id @default(uuid(7)) @db.Uuid
  messageId String       @unique @db.Uuid
  question  String
  /// várias opções por pessoa
  multiple  Boolean      @default(false)
  endsAt    DateTime?    @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id       String     @id @default(uuid(7)) @db.Uuid
  pollId   String     @db.Uuid
  text     String
  position Int
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes    PollVote[]

  @@index([pollId])
}

model PollVote {
  pollId    String     @db.Uuid
  optionId  String     @db.Uuid
  userId    String     @db.Uuid
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, optionId, userId])
  @@index([pollId, userId])
}

enum OverrideSubject {
  role
  member
}

model ChannelPermissionOverride {
  channelId   String          @db.Uuid
  subjectType OverrideSubject
  subjectId   String          @db.Uuid
  allow       Int             @default(0)
  deny        Int             @default(0)
  channel     Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([channelId, subjectType, subjectId])
}

enum ConversationKind {
  dm
  group
}

model Conversation {
  id         String               @id @default(uuid(7)) @db.Uuid
  kind       ConversationKind
  name       String?
  /** Para DMs: par canônico "lowId:highId", garante uma DM por par. */
  dmKey      String?              @unique
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  members    ConversationMember[]
  messages   Message[]
  readStates ReadState[]
}

model ConversationMember {
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  joinedAt       DateTime     @default(now()) @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid(7)) @db.Uuid
  authorId       String        @db.Uuid
  /** XOR com conversationId (constraint CHECK na migração). */
  channelId      String?       @db.Uuid
  conversationId String?       @db.Uuid
  /** Idempotência: o mesmo requestId do mesmo autor não cria segunda mensagem. */
  requestId      String        @db.Uuid
  body           String
  mentions       String[]      @db.Uuid
  mentionEveryone Boolean      @default(false)
  replyToId      String?       @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  editedAt       DateTime?     @db.Timestamptz(3)
  deletedAt      DateTime?     @db.Timestamptz(3)
  /** Fixada no canal/conversa (quem fixou fica em pinnedById, sem relação). */
  pinnedAt       DateTime?     @db.Timestamptz(3)
  pinnedById     String?       @db.Uuid
  author         User          @relation(fields: [authorId], references: [id])
  channel        Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        Message?      @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]     @relation("Replies")
  attachments    Attachment[]
  reactions      Reaction[]
  boardCard      BoardCard?
  poll           Poll?

  @@unique([authorId, requestId])
  @@index([channelId, createdAt, id])
  @@index([conversationId, createdAt, id])
}

model Attachment {
  id           String   @id @default(uuid(7)) @db.Uuid
  uploaderId   String   @db.Uuid
  /** null até ser vinculado a uma mensagem; órfãos expiram (limpeza periódica). */
  messageId    String?  @db.Uuid
  storageKey   String   @unique
  mime         String
  sizeBytes    Int
  originalName String
  sha256       String
  width        Int?
  height       Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  uploader     User     @relation(fields: [uploaderId], references: [id])
  message      Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploaderId, createdAt])
}

model Reaction {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
}

model ReadState {
  id                String        @id @default(uuid(7)) @db.Uuid
  userId            String        @db.Uuid
  channelId         String?       @db.Uuid
  conversationId    String?       @db.Uuid
  lastReadMessageId String?       @db.Uuid
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel           Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation      Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@unique([userId, conversationId])
  @@index([userId, updatedAt])
}

model UserSettings {
  userId    String   @id @db.Uuid
  version   Int
  json      Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String   @db.Uuid
  serverId  String?  @db.Uuid
  action    String
  targetId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  actor     User     @relation(fields: [actorId], references: [id])
  server    Server?  @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
}

/// Convite para servidor privado: código aleatório, sem expiração; o criador ou quem gerencia o servidor revoga.
model Invite {
  code      String   @id
  serverId  String   @db.Uuid
  creatorId String   @db.Uuid
  uses      Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([serverId])
}

/// Efeito sonoro do servidor (ADR-0016): qualquer membro envia; quem está na chamada toca para todos dela.
model SoundEffect {
  id          String   @id @default(uuid(7)) @db.Uuid
  serverId    String   @db.Uuid
  name        String
  /// emoji opcional mostrado no botão
  emoji       String?
  /// volume do som (0–1), escolhido no envio
  volume      Float    @default(1)
  storageKey  String
  mime        String
  sizeBytes   Int
  durationMs  Int
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([serverId])
}
