# Copie para infra/docker/.env e preencha. NUNCA commite o arquivo .env.
POSTGRES_PASSWORD=
PUBLIC_API_URL=https://chat.exemplo.com
CORS_ORIGINS=https://chat.exemplo.com
TRUST_PROXY=true
# Cabeçalho com o IP real do cliente posto pelo proxy de borda (ex.: cf-connecting-ip atrás da Cloudflare).
# Vazio = usa o IP da conexão. Só defina se TODO o tráfego passa por esse proxy (senão o cabeçalho é forjável).
CLIENT_IP_HEADER=
JWT_ACCESS_SECRET=
ATTACHMENT_URL_SECRET=
LIVEKIT_URL=wss://rtc.exemplo.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# MINIO_ROOT_PASSWORD=   # somente com --profile s3

# Entrada só com apelido (ADR-0007)
GUEST_JOIN_ENABLED=true
# Recomendado se a instância estiver exposta na internet; vazio = qualquer um que alcance o servidor entra.
INSTANCE_ACCESS_CODE=
INSTANCE_NAME=OpenCord
GUEST_JOIN_PER_IP_HOUR=10

# Download do app desktop para quem acessa pelo navegador (botão "Baixar para Windows").
# Use UM dos dois: link externo do instalador OU pasta com os .exe (a API serve o mais recente).
DESKTOP_DOWNLOAD_URL=
DOWNLOADS_DIR=
