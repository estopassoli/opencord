{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCord",
  "version": "0.3.0",
  "identifier": "org.opencord.tauri",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../resources/oc-audio.exe": "oc-audio.exe",
      "../resources/oc-input.exe": "oc-input.exe",
      "../resources/oc-live.exe": "oc-live.exe"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR"] }
    }
  }
}
