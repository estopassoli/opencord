{
  "name": "@opencord/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "dev": "tsc -p tsconfig.build.json && node --env-file=../../.env --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "dev:watch": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file=../../.env --enable-source-maps --watch-path=dist dist/main.js)"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/websockets": "11.2.7",
    "@node-rs/argon2": "2.2.2",
    "@opencord/contracts": "workspace:*",
    "@opencord/db": "workspace:*",
    "fastify": "5.11.3",
    "file-type": "22.2.0",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "livekit-server-sdk": "2.19.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.18",
    "@types/node": "24.19.2",
    "socket.io-client": "4.8.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.11",
    "vitest": "3.2.7",
    "@livekit/rtc-node": "1.1.0"
  }
}
