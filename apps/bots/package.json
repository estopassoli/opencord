{
  "name": "@opencord/bots",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Bots públicos oficiais do OpenCord (YOU6, Dínamo, Carlos, Dank Mineiro, Tíquete, Oráculo) — ADR-0037",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file=../../.env --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@opencord-chat/bot": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  }
}
